@* Model incluye Orden, Mesa, Detalles, Platillos y Pagos. Los importes se muestran desde la factura
   persistida, no se recalculan en la vista, para que el comprobante represente el cobro emitido. *@
@model Factura
@{ ViewData["Title"] = "Factura " + Model.IdFactura; }
<div class="card" style="max-width:560px"><div class="card-body">
  <h3>Factura #@Model.IdFactura</h3><p class="text-muted">@Model.Fecha.ToString("dd/MM/yyyy HH:mm") · Mesa @(Model.Orden?.Mesa?.NumeroMesa.ToString() ?? "No disponible")</p>
  @if (Model.Orden is null) {
    <div class="alert alert-warning">La orden asociada no está disponible. Los importes registrados en la factura se conservan abajo.</div>
  } else if (Model.Orden.Detalles.Count == 0) {
    <div class="alert alert-warning">No hay líneas de detalle disponibles para esta orden.</div>
  }
  <div class="table-responsive">
  <table class="table table-sm"><tbody>
  @* Subtotal por línea proviene de DetalleOrden; el encabezado de factura conserva IVA y total cobrados. *@
  @if (Model.Orden is not null) {
    @foreach (var d in Model.Orden.Detalles) { <tr><td>@d.Cantidad × @(d.Platillo?.Nombre ?? "Platillo no disponible")</td><td class="text-end">$@d.Subtotal.ToString("N2")</td></tr> }
  }
  </tbody></table>
  </div>
  <p class="mb-1">Subtotal: $@Model.Subtotal.ToString("N2")</p><p class="mb-1">IVA (13%): $@Model.IVA.ToString("N2")</p>
  <h5>Total: $@Model.Total.ToString("N2")</h5>
  @foreach (var p in Model.Pagos) { <p class="text-muted mb-0">Pago: @p.MetodoPago · $@p.Monto.ToString("N2")</p> }
</div></div>
<a class="btn btn-link" asp-action="Index">Volver</a>
