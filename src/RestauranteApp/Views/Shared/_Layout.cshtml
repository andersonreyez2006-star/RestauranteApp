@* Marco común de todas las páginas. Define recursos visuales, navegación basada en claims,
   mensajes TempData y, solo para visitantes anónimos, el widget del asistente. *@
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Restaurante</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
  // Se calcula una sola vez por render y se reutiliza para decidir qué enlaces de navegación presentar.
  var autenticado = User.Identity?.IsAuthenticated == true;
  var administrador = User.IsInRole("Administrador");
  var mesero = User.IsInRole("Mesero");
  var cocina = User.IsInRole("Cocina");
  var cajero = User.IsInRole("Cajero");
  var rolActual = administrador ? "Administrador" : cocina ? "Cocina" : cajero ? "Cajero" : mesero ? "Mesero" : "";
  var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
  var esPaginaError = controladorActual == "Account" &&
      ViewContext.RouteData.Values["action"]?.ToString() == "Error";
}
<nav class="navbar navbar-expand navbar-dark site-navbar" aria-label="Navegación principal"><div class="container">
  <a class="navbar-brand" asp-controller="@(cocina ? "Cocina" : "Platillos")" asp-action="Index"><span class="brand-mark">R</span> Restaurante</a>
  @if (esPaginaError) {
    <span class="error-nav-status">Aviso del sistema</span>
  } else {
  <div class="navbar-nav me-auto">
    @if (!cocina) {
      <a class="nav-link @(controladorActual == "Platillos" ? "active" : null)"
         aria-current="@(controladorActual == "Platillos" ? "page" : null)"
         asp-controller="Platillos" asp-action="Index">Menú</a>
    }
    @if (!autenticado) {
      <a class="nav-link @(controladorActual == "Ordenes" ? "active" : null)"
         aria-current="@(controladorActual == "Ordenes" ? "page" : null)"
         asp-controller="Ordenes" asp-action="CreatePublic">Pedir en mesa</a>
    }
    @if (administrador || mesero || cajero) {
      <a class="nav-link @(controladorActual == "Ordenes" ? "active" : null)"
         aria-current="@(controladorActual == "Ordenes" ? "page" : null)"
         asp-controller="Ordenes" asp-action="Index">Órdenes</a>
    }
    @if (administrador || cocina) {
      <a class="nav-link @(controladorActual == "Cocina" ? "active" : null)"
         aria-current="@(controladorActual == "Cocina" ? "page" : null)"
         asp-controller="Cocina" asp-action="Index">Cocina</a>
    }
    @if (administrador || cajero) {
      <a class="nav-link @(controladorActual == "Facturas" ? "active" : null)"
         aria-current="@(controladorActual == "Facturas" ? "page" : null)"
         asp-controller="Facturas" asp-action="Index">Facturas</a>
    }
    @if (administrador) {
      <a class="nav-link @(controladorActual == "Mesas" ? "active" : null)"
         aria-current="@(controladorActual == "Mesas" ? "page" : null)"
         asp-controller="Mesas" asp-action="Index">Mesas</a>
      <a class="nav-link @(controladorActual == "Categorias" ? "active" : null)"
         aria-current="@(controladorActual == "Categorias" ? "page" : null)"
         asp-controller="Categorias" asp-action="Index">Categorías</a>
    }
    @if (administrador || cajero) {
      <a class="nav-link @(controladorActual == "Reportes" ? "active" : null)"
         aria-current="@(controladorActual == "Reportes" ? "page" : null)"
         asp-controller="Reportes" asp-action="Index">Reportes</a>
    }
  </div>
  }
  <div class="navbar-nav account-nav">
    @if (esPaginaError) {
      @* Evita ofrecer navegación de módulos desde una página que informa de una solicitud fallida. *@
    } else if (autenticado) {
      <span class="role-badge">@rolActual</span>
      <span class="navbar-text me-3">@User.Identity?.Name</span>
      <form method="post" asp-controller="Account" asp-action="Logout"><button class="btn btn-sm btn-outline-light">Salir</button></form>
    } else {
      <a class="nav-link @(controladorActual == "Account" ? "active" : null)"
         aria-current="@(controladorActual == "Account" ? "page" : null)"
         asp-controller="Account" asp-action="Login">Ingresar</a>
    }
  </div></div></nav>
<main class="container page-content @(esPaginaError ? "error-page-content" : null)">
  @if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
  @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
  @RenderBody()
</main>
@if (!autenticado || administrador) {
  @* Visitantes usan el FAQ público; el administrador recibe un chat separado protegido por rol. *@
  @* aria-hidden/aria-expanded se sincronizan en JavaScript para lectores de pantalla y teclado. *@
  <section id="chatbot-panel" class="chatbot-panel" aria-label="@(administrador ? "Asistente administrativo" : "Asistente del restaurante")" aria-hidden="true">
    <header class="chatbot-header">
      <div><span class="chatbot-status"></span><strong>@(administrador ? "Asistente administrativo" : "Ayuda del restaurante")</strong><small>@(administrador ? "Ventas, órdenes e inventario" : "Menú y pedidos")</small></div>
      <button id="chatbot-close" class="chatbot-close" type="button" aria-label="Cerrar chat">×</button>
    </header>
    <div id="chatbot-messages" class="chatbot-messages" aria-live="polite">
      <div class="chat-message chat-message-assistant">@(administrador
          ? "Hola. Puedo consultar ventas de hoy, órdenes abiertas, inventario, existencias bajas o el estado de un platillo. Las consultas son de solo lectura."
          : "¡Hola! Puedo mostrarte platillos disponibles, precios, categorías y descripciones, recomendarte opciones, consultar el clima de una ciudad o explicarte cómo pedir en mesa. ¿Qué se te antoja?")</div>
    </div>
    <form id="chatbot-form" class="chatbot-form">
      <input id="chatbot-input" class="form-control" maxlength="500" placeholder="@(administrador ? "Consulta ventas, pedidos o inventario…" : "Escribe tu pregunta…")" aria-label="Tu pregunta" required />
      <button class="btn btn-primary" type="submit" aria-label="Enviar pregunta">Enviar</button>
    </form>
    <p class="chatbot-note">@(administrador ? "Solo lectura: el chat no crea ni modifica registros." : "El clima usa Open-Meteo. No compartas datos personales o de pago.")</p>
  </section>
  <button id="chatbot-toggle" class="chatbot-toggle" type="button" aria-expanded="false">
    <span aria-hidden="true">✦</span> @(administrador ? "Asistente administrativo" : "¿Necesitas ayuda?")
  </button>
  <script>
  (() => {
    // Encapsula los selectores y listeners para no crear variables globales ni interferir con otras vistas.
    const panel = document.getElementById('chatbot-panel');
    const toggle = document.getElementById('chatbot-toggle');
    const close = document.getElementById('chatbot-close');
    const messages = document.getElementById('chatbot-messages');
    const form = document.getElementById('chatbot-form');
    const input = document.getElementById('chatbot-input');
    const button = form.querySelector('button');
    const endpoint = '@(administrador ? "/Asistente/PreguntarAdministrador" : "/Asistente/Preguntar")';

    // Mantiene el panel visual y sus atributos ARIA sincronizados; enfoca el campo al abrir.
    const setOpen = (open) => {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
    };

    const addMessage = (text, kind) => {
      // textContent trata pregunta y respuesta como texto plano, evitando inyectar HTML recibido del servidor.
      const message = document.createElement('div');
      message.className = `chat-message chat-message-${kind}`;
      message.textContent = text;
      messages.appendChild(message);
      messages.scrollTop = messages.scrollHeight;
      return message;
    };

    toggle.addEventListener('click', () => setOpen(!panel.classList.contains('is-open')));
    close.addEventListener('click', () => setOpen(false));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question) return;

      addMessage(question, 'user');
      input.value = '';
      input.disabled = true;
      button.disabled = true;
      const pending = addMessage('Estoy buscando una respuesta…', 'assistant');

      try {
        // El servidor valida el rol, el contenido y el límite de solicitudes; la interfaz no es un control de acceso.
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ texto: question })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.respuesta || 'No se pudo procesar la consulta.');
        pending.textContent = data.respuesta;
      } catch (error) {
        pending.textContent = error.message || 'No pude conectar ahora. Intenta de nuevo en un momento.';
        pending.classList.add('chat-message-error');
      } finally {
        input.disabled = false;
        button.disabled = false;
        input.focus();
        messages.scrollTop = messages.scrollHeight;
      }
    });
  })();
  </script>
}
</body>
</html>
