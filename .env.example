# Copia este archivo a .env y cambia la contraseña antes de iniciar Docker.
# Debe cumplir los requisitos de contraseña de SQL Server (mayúscula,
# minúscula, número y símbolo; mínimo 8 caracteres).
SA_PASSWORD=Cambia_Esta_Clave_123!

# Opcional: configura estos valores si tienes un despliegue en Azure OpenAI.
AI_ENDPOINT=
AI_API_KEY=
AI_DEPLOYMENT=
