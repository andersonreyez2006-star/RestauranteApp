@* Model contiene la mesa, los detalles y los platillos. Las comprobaciones de rol/estado ocultan
   acciones no disponibles en la interfaz; el controlador repite las mismas reglas en el servidor. *@
@model Orden
@{ ViewData["Title"] = "Orden " + Model.IdOrden; var facturaExistenteId = ViewBag.FacturaExistenteId as int?; var cerrada = Model.Estado == "Facturada" || facturaExistenteId.HasValue; var total = Model.Detalles.Sum(d => d.Subtotal);
   var puedeEditar = !cerrada && (User.IsInRole("Administrador") || User.IsInRole("Mesero")); }
<h2>Orden #@Model.IdOrden · Mesa @Model.Mesa?.NumeroMesa <span class="badge bg-secondary">@Model.Estado</span></h2>
@if (facturaExistenteId.HasValue) {
  <div class="alert alert-info">Esta orden ya está facturada. No se puede cobrar ni modificar de nuevo.
    <a asp-controller="Facturas" asp-action="Details" asp-route-id="@facturaExistenteId.Value">Ver factura #@facturaExistenteId.Value</a>
  </div>
}
<table class="table"><thead><tr><th>Platillo</th><th>Cant.</th><th>Precio</th><th>Subtotal</th><th></th></tr></thead><tbody>
@* total es la suma de importes guardados en cada detalle, no del precio actual del menú. *@
@foreach (var d in Model.Detalles) {
  <tr><td>@d.Platillo?.Nombre</td><td>@d.Cantidad</td><td>$@d.PrecioUnitario.ToString("N2")</td><td>$@d.Subtotal.ToString("N2")</td>
  <td class="text-end">@if (puedeEditar) { <form method="post" asp-action="RemoveItem" asp-route-idDetalle="@d.IdDetalle"><button class="btn btn-sm btn-outline-danger">Quitar</button></form> }</td></tr> }
</tbody><tfoot><tr><th colspan="3" class="text-end">Subtotal</th><th>$@total.ToString("N2")</th><th></th></tr></tfoot></table>
@if (puedeEditar) {
  @* Agregar productos solo está habilitado para una orden no facturada y personal con rol autorizado. *@
  <form method="post" asp-action="AddItem" asp-route-id="@Model.IdOrden" class="row g-2 mb-4" style="max-width:560px">
    <div class="col-7"><select name="idPlatillo" class="form-select" asp-items="@(ViewBag.Platillos as SelectList)"></select></div>
    <div class="col-3"><input name="cantidad" type="number" min="1" value="1" class="form-control" /></div>
    <div class="col-2"><button class="btn btn-primary">Agregar</button></div>
  </form> }
@if (!cerrada && Model.Detalles.Any() && (User.IsInRole("Administrador") || User.IsInRole("Cajero"))) {
  @* Solo se ofrece facturación para órdenes abiertas con líneas y para administrador/cajero;
     la acción Crear vuelve a comprobar estas condiciones antes de emitir el comprobante. *@
  <form method="post" asp-controller="Facturas" asp-action="Crear" class="row g-2" style="max-width:420px">
    <input type="hidden" name="idOrden" value="@Model.IdOrden" />
    <div class="col-7"><select name="metodoPago" class="form-select"><option>Efectivo</option><option>Tarjeta</option><option>Transferencia</option></select></div>
    <div class="col-5"><button class="btn btn-success">Facturar y cobrar</button></div>
  </form> }
<a class="btn btn-link mt-3" asp-action="Index">Volver</a>
