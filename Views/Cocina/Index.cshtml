@* Tablero de cocina: muestra los detalles de cada orden activa y permite avanzar su preparación. *@
@model IEnumerable<Orden>
@{ ViewData["Title"] = "Cocina"; }
<h2>Pantalla de despacho</h2>
@if (!Model.Any()) { <p class="text-muted">No hay órdenes pendientes.</p> }
<div class="row">
@foreach (var o in Model) {
  <div class="col-md-4 mb-3"><div class="card"><div class="card-header d-flex justify-content-between">
    <strong>Mesa @o.Mesa?.NumeroMesa · #@o.IdOrden</strong><span class="badge bg-warning text-dark">@o.Estado</span></div>
    <ul class="list-group list-group-flush">@foreach (var d in o.Detalles) { <li class="list-group-item">@d.Cantidad × @d.Platillo?.Nombre</li> }</ul>
    <div class="card-body"><form method="post" asp-action="Avanzar" asp-route-id="@o.IdOrden">
      <button class="btn btn-sm btn-primary">@(o.Estado == "Pendiente" ? "Iniciar preparación" : "Marcar como lista")</button></form></div></div></div> }
</div>
