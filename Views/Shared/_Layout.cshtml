@* Marco común de todas las páginas. Define recursos visuales, navegación basada en claims,
   mensajes TempData y, solo para visitantes anónimos, el widget del asistente. *@
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Restaurante</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
  // Se calcula una sola vez por render y se reutiliza para decidir qué enlaces de navegación presentar.
  var autenticado = User.Identity?.IsAuthenticated == true;
  var administrador = User.IsInRole("Administrador");
  var mesero = User.IsInRole("Mesero");
  var cocina = User.IsInRole("Cocina");
  var cajero = User.IsInRole("Cajero");
  var rolActual = administrador ? "Administrador" : cocina ? "Cocina" : cajero ? "Cajero" : mesero ? "Mesero" : "";
}
<nav class="navbar navbar-expand navbar-dark site-navbar"><div class="container">
  <a class="navbar-brand" asp-controller="Platillos" asp-action="Index"><span class="brand-mark">R</span> Restaurante</a>
  <div class="navbar-nav me-auto">
    <a class="nav-link" asp-controller="Platillos" asp-action="Index">Menú</a>
    @if (!autenticado) {
      <a class="nav-link" asp-controller="Ordenes" asp-action="CreatePublic">Pedir en mesa</a>
    }
    @if (administrador || mesero || cajero) { <a class="nav-link" asp-controller="Ordenes" asp-action="Index">Órdenes</a> }
    @if (administrador || cocina) { <a class="nav-link" asp-controller="Cocina" asp-action="Index">Cocina</a> }
    @if (administrador || cajero) { <a class="nav-link" asp-controller="Facturas" asp-action="Index">Facturas</a> }
    @if (administrador) {
      <a class="nav-link" asp-controller="Mesas" asp-action="Index">Mesas</a>
      <a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorías</a>
    }
    @if (administrador || cajero) { <a class="nav-link" asp-controller="Reportes" asp-action="Index">Reportes</a> }
  </div>
  <div class="navbar-nav account-nav">
    @if (autenticado) {
      <span class="role-badge">@rolActual</span>
      <span class="navbar-text me-3">@User.Identity?.Name</span>
      <form method="post" asp-controller="Account" asp-action="Logout"><button class="btn btn-sm btn-outline-light">Salir</button></form>
    } else { <a class="nav-link" asp-controller="Account" asp-action="Login">Ingresar</a> }
  </div></div></nav>
<main class="container page-content">
  @if (TempData["Ok"] != null) { <div class="alert alert-success">@TempData["Ok"]</div> }
  @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
  @RenderBody()
</main>
@if (!autenticado) {
  @* El chat solo aparece a visitantes; las respuestas se solicitan al endpoint del asistente. *@
  @* aria-hidden/aria-expanded se sincronizan en JavaScript para lectores de pantalla y teclado. *@
  <section id="chatbot-panel" class="chatbot-panel" aria-label="Asistente del restaurante" aria-hidden="true">
    <header class="chatbot-header">
      <div><span class="chatbot-status"></span><strong>Ayuda del restaurante</strong><small>Menú y pedidos</small></div>
      <button id="chatbot-close" class="chatbot-close" type="button" aria-label="Cerrar chat">×</button>
    </header>
    <div id="chatbot-messages" class="chatbot-messages" aria-live="polite">
      <div class="chat-message chat-message-assistant">¡Hola! Puedo ayudarte con el menú, precios y cómo hacer tu pedido. ¿Qué quieres saber?</div>
    </div>
    <form id="chatbot-form" class="chatbot-form">
      <input id="chatbot-input" class="form-control" maxlength="500" placeholder="Escribe tu pregunta…" aria-label="Tu pregunta" required />
      <button class="btn btn-primary" type="submit" aria-label="Enviar pregunta">Enviar</button>
    </form>
    <p class="chatbot-note">No compartas datos personales o de pago.</p>
  </section>
  <button id="chatbot-toggle" class="chatbot-toggle" type="button" aria-expanded="false">
    <span aria-hidden="true">✦</span> ¿Necesitas ayuda?
  </button>
  <script>
  (() => {
    // Encapsula los selectores y listeners para no crear variables globales ni interferir con otras vistas.
    const panel = document.getElementById('chatbot-panel');
    const toggle = document.getElementById('chatbot-toggle');
    const close = document.getElementById('chatbot-close');
    const messages = document.getElementById('chatbot-messages');
    const form = document.getElementById('chatbot-form');
    const input = document.getElementById('chatbot-input');
    const button = form.querySelector('button');

    // Mantiene el panel visual y sus atributos ARIA sincronizados; enfoca el campo al abrir.
    const setOpen = (open) => {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
    };

    const addMessage = (text, kind) => {
      // textContent trata pregunta y respuesta como texto plano, evitando inyectar HTML recibido del servidor.
      const message = document.createElement('div');
      message.className = `chat-message chat-message-${kind}`;
      message.textContent = text;
      messages.appendChild(message);
      messages.scrollTop = messages.scrollHeight;
      return message;
    };

    toggle.addEventListener('click', () => setOpen(!panel.classList.contains('is-open')));
    close.addEventListener('click', () => setOpen(false));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question) return;

      addMessage(question, 'user');
      input.value = '';
      input.disabled = true;
      button.disabled = true;
      const pending = addMessage('Estoy buscando una respuesta…', 'assistant');

      try {
        // La pregunta viaja en JSON al endpoint público; validación, limitación de solicitudes y respuesta
        // se resuelven en el servidor, nunca se confía en las restricciones visuales del formulario.
        const response = await fetch('/Asistente/Preguntar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ texto: question })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.respuesta || 'No se pudo procesar la consulta.');
        pending.textContent = data.respuesta;
      } catch (error) {
        pending.textContent = error.message || 'No pude conectar ahora. Intenta de nuevo en un momento.';
        pending.classList.add('chat-message-error');
      } finally {
        input.disabled = false;
        button.disabled = false;
        input.focus();
        messages.scrollTop = messages.scrollHeight;
      }
    });
  })();
  </script>
}
</body>
</html>
