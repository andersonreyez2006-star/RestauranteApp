@model Mesa
@{ ViewData["Title"] = Model.IdMesa == 0 ? "Nueva mesa" : "Editar mesa"; }
<h2>@ViewData["Title"]</h2>
<form method="post" asp-action="@(Model.IdMesa == 0 ? "Create" : "Edit")" asp-route-id="@Model.IdMesa" style="max-width:420px">
  <input type="hidden" asp-for="IdMesa" />
  <div class="mb-3"><label asp-for="NumeroMesa" class="form-label">Número</label><input asp-for="NumeroMesa" class="form-control" /><span asp-validation-for="NumeroMesa" class="text-danger"></span></div>
  <div class="mb-3"><label asp-for="Capacidad" class="form-label"></label><input asp-for="Capacidad" class="form-control" /><span asp-validation-for="Capacidad" class="text-danger"></span></div>
  <div class="mb-3"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select"><option>Libre</option><option>Ocupada</option></select></div>
  <button class="btn btn-primary">Guardar</button> <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>
